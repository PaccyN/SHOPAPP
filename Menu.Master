                                     <li><a href="Stock.aspx">STOCK</a></li>
                                     <li><a href="Expense.aspx">EXPENSE</a></li>
                                     <li><a href="Filling.aspx">Document</a></li>
                                </ul>

                            </asp:Panel>
                        </td>
                        <td>
                            <asp:Panel ID="Panel2" runat="server"  Height="640px" Width="1300px">
                                <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                                </asp:ContentPlaceHolder>
                            </asp:Panel>
                        </td>
                    </tr>
                </table>
            
        </div>
    </form>
</body>
</html>
