<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Menu.master.cs" Inherits="ShopManagement.Menu" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="\Styles\MasterStyles.css" type="text/css" />
</head>
<body>
    
    <form id="form1" runat="server">
        <div>          
                <table>
                    <tr>
                        <td>
                            <asp:Panel ID="Panel1" runat="server" Height="640px" Width="250px" BackColor="#CC99FF" CssClass="panelMenu">
                                <asp:Image ID="Image1" runat="server" Height="80px" ImageUrl="/Image/Logo1.png" width="120px" />
                                <ul>
                                    <li><a href="DashBoard.aspx">DashBoard</a></li>
                                    <li><a href="PageItem.aspx">ITEM</a></li>
                                     <li><a href="PageClient.aspx">CLIENT</a></li>
                                     <li><a  href="PageReplenishment.aspx">REPLENISHMENT</a></li>
